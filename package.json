{
  "name": "bctsl-sdk",
  "version": "1.0.0",
  "description": "SDK to interface with bctsl-contracts",
  "main": "./.build/esm/index.js",
  "types": "./.build/types/index.d.ts",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -b ./tsconfig.cjs.json ./tsconfig.esm.json ./tsconfig.types.json",
    "build:clean": "rm -rf ./.build",
    "postinstall": "npm run-script build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./.build/types/index.d.ts",
      "require": "./.build/cjs/index.js",
      "import": "./.build/esm/index.js",
      "default": "./.build/esm/index.js"
    }
  },
  "license": "ISC",
  "dependencies": {
    "@aeternity/aepp-sdk": "^15.0.1",
    "aeternity-fungible-token": "git+ssh://git@github.com/aeternity/aeternity-fungible-token#v2.2.0",
    "bctsl-contracts": "git+https://github.com/bctsl/bctsl-contracts.git#v1.0.0",
    "bignumber.js": "^9.1.2"
  },
  "devDependencies": {
    "@aeternity/aeproject": "^5.1.0",
    "@types/node": "^20.14.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "engines": {
    "npm": ">=8.0.0",
    "node": ">=18.0.0"
  }
}
